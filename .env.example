# Copy to .env.local and fill in. Never commit real values.

# From https://publish.buffer.com/settings/api → App Clients (private client)
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=

# Public HTTPS base URL, no trailing slash.
# Local: https://localhost:3000 (run `pnpm dev`, which uses a self-signed cert)
# Register "<APP_URL>/api/auth/buffer/callback" as a redirect URI in Buffer.
APP_URL=https://localhost:3000

# Encrypts session cookies. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Cloudinary (image hosting): dashboard → Product environment credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Neon Postgres, pooled connection string
DATABASE_URL=

# Google AI Studio key, model gemini-3.5-flash-lite
GEMINI_API_KEY=
