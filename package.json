{
  "name": "chalk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --experimental-https --experimental-https-key certificates/localhost-key.pem --experimental-https-cert certificates/localhost.pem",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "certs": "mkdir -p certificates && openssl req -x509 -newkey rsa:2048 -nodes -days 30 -keyout certificates/localhost-key.pem -out certificates/localhost.pem -subj /CN=localhost -addext subjectAltName=DNS:localhost,IP:127.0.0.1"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "@phosphor-icons/react": "2.1.10",
    "cloudinary": "2.11.0",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.17",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.4.2"
}
